# 複製成 .env.local
# ---- 後端服務（BFF 在 server 端呼叫）----
# 本機：各服務各自的 port。正式環境（Vercel）：四個都填 https://api.你的網域（Caddy 依路徑轉給各服務）
AUTH_SVC_BASE_URL=http://localhost:8001
DOCUMENT_SVC_BASE_URL=http://localhost:8003
TREE_SVC_BASE_URL=http://localhost:8002
ACTIVITY_SVC_BASE_URL=http://localhost:8004

# 瀏覽器直接上傳檔案的網址（Vercel Function body 上限 4.5MB，檔案不經過 Next.js）
# 正式環境：https://api.你的網域
DOCUMENT_PUBLIC_URL=http://localhost:8003
# 上傳票簽章密鑰，必須和後端 .env 的 UPLOAD_TICKET_SECRET 相同
UPLOAD_TICKET_SECRET=

ACCESS_COOKIE=access_token
REFRESH_COOKIE=refresh_token
# 正式環境（https）設 true
COOKIE_SECURE=false

# ---- Google 登入（Google Cloud Console → OAuth 2.0 Client ID → Web application）----
# Authorized JavaScript origins 要加上 http://localhost:3000 與正式網域
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
